HOST=127.0.0.1
PORT=3001

# Opcional: quando preenchida, chamadas de API (exceto a interface local)
# devem enviar o header X-API-Key.
API_KEY=

# Intervalo minimo entre envios, em milissegundos.
SEND_INTERVAL_MS=3000

# Impede um segundo envio identico ao mesmo numero durante este periodo.
DUPLICATE_WINDOW_MS=300000

# Suporta as variaveis {{nome}} e {{empresa}}.
DEFAULT_MESSAGE=Ola {{nome}}, tudo bem? Gostaria de falar com a equipe da {{empresa}}. Podemos conversar?

