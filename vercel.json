{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**",
      "maxDuration": 60
    },
    "api/baileys.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/baileys-internal",
      "destination": "/api/baileys"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
